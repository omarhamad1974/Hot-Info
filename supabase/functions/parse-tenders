// Edge Function: parse-tenders
// Turns the saved OCR text of ONE tender image into draft rows in public.tenders.
// One image often holds several tenders, so the result is many rows. Nothing is approved here:
// the admin reviews every row in the review table.
//
// Steps: 1) the model (Gemini free tier, TEXT only) splits the text into tenders and copies each field as printed;
//        2) this file normalizes Arabic digits, prices and dates with plain code (not with the model).
// The model is swappable: add another entry to PARSERS. Secret: GEMINI_API_KEY. Optional: GEMINI_PARSE_MODEL.
//
// POST JSON: { image_id }   Drafts already in the table for this image are replaced; approved rows stay.
// Deploy:  supabase functions deploy parse-tenders      (leave "Verify JWT" on)
import { createClient } from "npm:@supabase/supabase-js@2";

const cors = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};
const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), { status, headers: { ...cors, "Content-Type": "application/json" } });
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// ------------------------------------------------------------ normalizers (plain code, tested)
const AR_DIGITS = "٠١٢٣٤٥٦٧٨٩", FA_DIGITS = "۰۱۲۳۴۵۶۷۸۹";
export const digits = (v: unknown): string =>
  String(v ?? "").replace(/[٠-٩]/g, (d) => String(AR_DIGITS.indexOf(d))).replace(/[۰-۹]/g, (d) => String(FA_DIGITS.indexOf(d)));

// "١٬٥٠٠٫٥٠ جنيه" -> 1500.5 ; "1,500" -> 1500 ; "1.500" -> 1500 ; "250.75" -> 250.75 ; "مجانا"/"" -> null
export function price(v: unknown): number | null {
  const s = digits(v).replace(/[٬،]/g, ",").replace(/٫/g, ".");
  const m = s.match(/\d[\d.,\s]*/);
  if (!m) return null;
  let t = m[0].replace(/\s+/g, "").replace(/[.,]+$/, "");
  const lastDot = t.lastIndexOf("."), lastCom = t.lastIndexOf(",");
  if (lastDot >= 0 && lastCom >= 0) { // both present: the LAST one is the decimal mark
    const dec = Math.max(lastDot, lastCom);
    t = t.slice(0, dec).replace(/[.,]/g, "") + "." + t.slice(dec + 1);
  } else if (lastCom >= 0 || lastDot >= 0) {
    const sep = lastCom >= 0 ? "," : ".", parts = t.split(sep), last = parts[parts.length - 1];
    // groups of exactly 3 digits after the mark = thousands; otherwise a decimal mark (only one allowed)
    t = parts.length > 2 || last.length === 3 ? parts.join("") : parts[0] + "." + last;
  }
  const n = Number(t);
  return Number.isFinite(n) && n >= 0 && n < 1e12 ? Math.round(n * 100) / 100 : null;
}

const fold = (s: string) =>
  s.replace(/[ً-ٰٟـ]/g, "").replace(/[أإآٱ]/g, "ا").replace(/ى/g, "ي").replace(/ة/g, "ه").trim();
const MONTH_SRC: Record<string, number> = {
  "يناير": 1, "كانون الثاني": 1, "فبراير": 2, "شباط": 2, "مارس": 3, "آذار": 3, "أبريل": 4, "إبريل": 4, "نيسان": 4,
  "مايو": 5, "أيار": 5, "يونيو": 6, "يونيه": 6, "حزيران": 6, "يوليو": 7, "يوليه": 7, "تموز": 7, "أغسطس": 8, "آب": 8,
  "سبتمبر": 9, "أيلول": 9, "أكتوبر": 10, "تشرين الأول": 10, "نوفمبر": 11, "تشرين الثاني": 11, "ديسمبر": 12, "كانون الأول": 12,
};
const MONTHS = new Map(Object.entries(MONTH_SRC).map(([k, v]) => [fold(k), v]));

const iso = (y: number, m: number, d: number): string | null => {
  const t = new Date(Date.UTC(y, m - 1, d));
  return t.getUTCFullYear() === y && t.getUTCMonth() === m - 1 && t.getUTCDate() === d
    ? `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}` : null;
};
const year = (n: number) => (n < 100 ? 2000 + n : n);

// Returns an ISO date or null. publish (YYYY-MM-DD) is used only when the printed date has no year.
export function sessionDate(v: unknown, publish?: string | null): { date: string | null; flags: string[] } {
  const s = digits(v), flags: string[] = [];
  if (!s.trim()) return { date: null, flags };
  let m = s.match(/(\d{4})\s*[\/\-.]\s*(\d{1,2})\s*[\/\-.]\s*(\d{1,2})/); // 2026/11/05
  if (m) { const d = iso(+m[1], +m[2], +m[3]); if (d) return { date: d, flags }; }
  m = s.match(/(\d{1,2})\s*[\/\-.]\s*(\d{1,2})\s*[\/\-.]\s*(\d{2,4})/);     // 05/11/2026 (day first)
  if (m) {
    let d = iso(year(+m[3]), +m[2], +m[1]);
    if (!d && +m[2] <= 31 && +m[1] <= 12) { d = iso(year(+m[3]), +m[1], +m[2]); if (d) flags.push("date-swapped"); }
    if (d) return { date: d, flags };
  }
  // day + month NAME (+ optional year): "5 نوفمبر 2026", "5 تشرين الثاني"
  const tok = fold(s).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
  for (let i = 0; i < tok.length; i++) {
    let mon = MONTHS.get(tok[i] + " " + (tok[i + 1] ?? "")), len = 2;
    if (!mon) { mon = MONTHS.get(tok[i]); len = 1; }
    if (!mon) continue;
    const num = (t?: string) => (t && /^\d+$/.test(t) ? +t : null);
    const day = [num(tok[i - 1]), num(tok[i + len])].find((n) => n !== null && n >= 1 && n <= 31) ?? null;
    if (day === null) continue;
    let y = [num(tok[i + len]), num(tok[i + len + 1])].find((n) => n !== null && n >= 100) ?? null;
    if (y === null) {
      const p = publish && /^\d{4}-\d{2}-\d{2}$/.test(publish) ? publish : null;
      if (!p) return { date: null, flags: ["no-year"] };
      y = +p.slice(0, 4);
      let d = iso(y, mon, day);
      if (d && d < new Date(Date.parse(p) - 30 * 864e5).toISOString().slice(0, 10)) d = iso(y + 1, mon, day);
      return { date: d, flags: ["year-guessed"] };
    }
    const d = iso(y, mon, day);
    if (d) return { date: d, flags };
  }
  return { date: null, flags };
}

// ------------------------------------------------------------ the model (swappable)
type Raw = { entity: string; subject: string; booklet_price: string; session_date: string; bid_bond: string; link: string; raw_text: string };
const STR = { type: "STRING" };
const SCHEMA = {
  type: "ARRAY",
  items: {
    type: "OBJECT",
    properties: { entity: STR, subject: STR, booklet_price: STR, session_date: STR, bid_bond: STR, link: STR, raw_text: STR },
    required: ["entity", "subject", "booklet_price", "session_date", "bid_bond", "link", "raw_text"],
  },
};
const PROMPT =
  "Below is OCR text from an Arabic newspaper page of tender announcements (مناقصات / ممارسات). The OCR may contain mistakes. " +
  "Split it into the separate tender announcements and return a JSON array with one object per announcement. " +
  "Fields (copy exactly as printed, do not translate, correct or invent; use an empty string when a field is absent): " +
  "entity = the authority issuing the tender (الجهة); subject = what is being tendered (موضوع المناقصة/العملية); " +
  "booklet_price = price of the conditions booklet (ثمن كراسة الشروط); " +
  "session_date = the date of the session / envelope opening (موعد الجلسة / فض المظاريف), with its time if printed; " +
  "bid_bond = the bid bond / initial guarantee (التأمين المؤقت / الابتدائي), amount or percentage; " +
  "link = a web address or email if printed; raw_text = the full original text of that one announcement. " +
  "Never merge two announcements and never split one announcement. Ignore headings, page numbers and advertisements that are not tenders.\n\nTEXT:\n";

async function gemini(text: string): Promise<Raw[]> {
  const key = Deno.env.get("GEMINI_API_KEY");
  if (!key) throw new Error("The secret GEMINI_API_KEY is not set in Supabase.");
  const model = Deno.env.get("GEMINI_PARSE_MODEL") ?? Deno.env.get("GEMINI_MODEL") ?? "gemini-2.5-flash";
  const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent`, {
    method: "POST",
    headers: { "Content-Type": "application/json", "x-goog-api-key": key },
    body: JSON.stringify({
      contents: [{ parts: [{ text: PROMPT + text }] }],
      generationConfig: { temperature: 0, responseMimeType: "application/json", responseSchema: SCHEMA },
    }),
  });
  const j = await res.json().catch(() => null);
  if (res.status === 429) throw new Error("Gemini free limit reached for now. Try again in a few minutes.");
  if (!res.ok) throw new Error(`Gemini error (HTTP ${res.status}): ${j?.error?.message ?? "unknown"}`);
  const out = (j?.candidates?.[0]?.content?.parts ?? []).map((p: any) => p.text ?? "").join("");
  let arr: unknown;
  try { arr = JSON.parse(out); } catch {
    const m = out.match(/\[[\s\S]*\]/);
    try { arr = m ? JSON.parse(m[0]) : null; } catch { arr = null; }
  }
  if (!Array.isArray(arr)) throw new Error("The model did not return a list of tenders. Try again.");
  return arr.map((o: any) => Object.fromEntries(
    ["entity", "subject", "booklet_price", "session_date", "bid_bond", "link", "raw_text"].map((k) => [k, String(o?.[k] ?? "").trim()]),
  ) as Raw);
}
const PARSERS: Record<string, (text: string) => Promise<Raw[]>> = { gemini };

// ------------------------------------------------------------ handler
Deno.serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: cors });
  if (req.method !== "POST") return json({ error: "POST only" }, 405);
  const url = Deno.env.get("SUPABASE_URL")!, anon = Deno.env.get("SUPABASE_ANON_KEY")!, service = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
  const caller = createClient(url, anon, { global: { headers: { Authorization: req.headers.get("Authorization") ?? "" } } });
  const { data: { user } } = await caller.auth.getUser();
  if (!user) return json({ error: "Please sign in again." }, 401);
  const { data: isAdmin } = await caller.rpc("is_admin");
  if (isAdmin !== true) return json({ error: "This account is not an admin." }, 403);

  let b: Record<string, string> = {};
  try { b = await req.json(); } catch { /* empty */ }
  if (!UUID.test(String(b.image_id ?? ""))) return json({ error: "Bad image id." }, 400);
  const admin = createClient(url, service, { auth: { persistSession: false } });
  const { data: img, error: e1 } = await admin.from("tender_images")
    .select("id,ocr_text,source_paper,page,publish_date,status").eq("id", b.image_id).single();
  if (e1 || !img) return json({ error: "Image not found." }, 404);
  const text = String(img.ocr_text ?? "").trim();
  if (text.length < 20) return json({ error: "Read the text of this image first (and make sure it is saved)." });

  let rows: Raw[];
  try { rows = await PARSERS[String(b.parser ?? "gemini")](text.slice(0, 30000)); }
  catch (e) { return json({ error: e instanceof Error ? e.message : String(e) }); }
  rows = rows.filter((r) => r.entity || r.subject || r.raw_text);
  if (!rows.length) return json({ error: "No tenders were found in this text." });

  const out = rows.map((r, i) => {
    const flags: string[] = [];
    const d = sessionDate(r.session_date, img.publish_date); flags.push(...d.flags);
    if (r.session_date && !d.date) flags.push("date?");
    const p = price(r.booklet_price);
    if (r.booklet_price && p === null && !/مجان|بدون|لا\s*يوجد/.test(r.booklet_price)) flags.push("price?");
    if (/مجان/.test(r.booklet_price)) flags.push("free-booklet");
    if (!r.entity) flags.push("no-entity");
    if (!r.subject) flags.push("no-subject");
    return {
      image_id: img.id, position: i + 1, status: "draft",
      entity: digits(r.entity), subject: digits(r.subject),
      booklet_price: /مجان/.test(r.booklet_price) ? 0 : p, booklet_price_raw: r.booklet_price || null,
      session_date: d.date, session_date_raw: r.session_date || null,
      bid_bond: digits(r.bid_bond) || null, link: r.link || null,
      source_paper: img.source_paper, page: img.page, publish_date: img.publish_date,
      raw_text: r.raw_text || null, flags: [...new Set(flags)].join(",") || null,
    };
  });
  const del = await admin.from("tenders").delete().eq("image_id", img.id).eq("status", "draft");
  if (del.error) return json({ error: "Could not clear the old drafts: " + del.error.message }, 500);
  const ins = await admin.from("tenders").insert(out);
  if (ins.error) return json({ error: "Could not save the rows (did you run supabase-step5-parse.sql?): " + ins.error.message }, 500);
  await admin.from("tender_images").update({ status: "parsed", updated_at: new Date().toISOString() }).eq("id", img.id);
  return json({ count: out.length, flagged: out.filter((r) => r.flags).length });
});
